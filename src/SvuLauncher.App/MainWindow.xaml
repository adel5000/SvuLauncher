<ui:FluentWindow x:Class="SvuLauncher.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SvuLauncher.App.ViewModels"
                 xmlns:views="clr-namespace:SvuLauncher.App.Views"
                 xmlns:res="clr-namespace:SvuLauncher.App.Resources"
                 Title="{x:Static res:Strings.AppTitle}"
                 Width="1040" Height="700" MinWidth="780" MinHeight="540"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Closing="OnClosing">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <views:SessionsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.AppTitle}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="HatGraduation24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</ui:FluentWindow>
