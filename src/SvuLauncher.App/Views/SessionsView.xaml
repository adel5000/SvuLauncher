<UserControl x:Class="SvuLauncher.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:SvuLauncher.App.Views"
             xmlns:res="clr-namespace:SvuLauncher.App.Resources">
    <DockPanel Margin="28,4,28,20">

        <!-- Header: title, user, microphone quick toggle, settings, sign out -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Sessions_Title}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <ui:SymbolIcon Symbol="PersonCircle24" FontSize="16" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource SecondaryText}" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Mic24}" Margin="0,0,8,0"
                           ToolTip="{x:Static res:Strings.Mic_Mute}" Command="{Binding Settings.ToggleMicrophoneCommand}"
                           Visibility="{Binding Settings.IsMicrophoneLive, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Appearance="Caution" Icon="{ui:SymbolIcon MicOff24}" Margin="0,0,8,0"
                           ToolTip="{x:Static res:Strings.Mic_Unmute}" Command="{Binding Settings.ToggleMicrophoneCommand}"
                           Visibility="{Binding Settings.IsMicrophoneMuted, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,8,0"
                           ToolTip="{x:Static res:Strings.Sessions_Settings}" Command="{Binding ToggleSettingsCommand}" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon SignOut24}"
                           Content="{x:Static res:Strings.Sessions_SignOut}" Command="{Binding SignOutCommand}" />
            </StackPanel>
        </Grid>

        <!-- Settings panel -->
        <views:SettingsView DockPanel.Dock="Right" Width="340" Margin="16,0,0,0" DataContext="{Binding Settings}"
                            Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource BoolToVisibility}}" />

        <!-- Filters (legacy: options, programs, courses) -->
        <ui:Card DockPanel.Dock="Top" Padding="20,16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static res:Strings.Filter_Scope}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}"
                              ToolTip="{Binding SelectedScope.Label}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <!-- Legacy: program and course are enabled only for "by program and course" -->
                <StackPanel Grid.Column="2" IsEnabled="{Binding IsProgramCourseEnabled}">
                    <TextBlock Text="{x:Static res:Strings.Filter_Program}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" DisplayMemberPath="Code" />
                </StackPanel>
                <StackPanel Grid.Column="4" IsEnabled="{Binding IsProgramCourseEnabled}">
                    <TextBlock Text="{x:Static res:Strings.Filter_Course}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" DisplayMemberPath="Code" />
                </StackPanel>
                <ui:Button Grid.Column="6" VerticalAlignment="Bottom" Appearance="Secondary" Height="34"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" Content="{x:Static res:Strings.Sessions_Refresh}"
                           Command="{Binding RefreshCommand}" />
            </Grid>
        </ui:Card>

        <!-- Messages -->
        <StackPanel DockPanel.Dock="Top">
            <ui:InfoBar Message="{Binding ErrorMessage}" IsOpen="{Binding HasError, Mode=OneWay}"
                        Severity="Error" IsClosable="False" Margin="0,0,0,12" />
            <ui:InfoBar Message="{Binding RunningMessage}" IsOpen="{Binding IsSessionRunning, Mode=OneWay}"
                        Severity="Success" IsClosable="False" Margin="0,0,0,12" />
        </StackPanel>

        <!-- List toolbar: local status filter and the sort order -->
        <Grid DockPanel.Dock="Top" Margin="4,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.StatusFilter_Label}" VerticalAlignment="Center" Margin="0,0,10,0"
                       Style="{StaticResource SecondaryText}" />
            <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="Label" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowSortDownLines24" FontSize="16" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.Sessions_SortHint}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="4,10,0,0" />

        <!-- Session list / loading / empty state -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Margin="0,0,0,8" Padding="16,12">
                                <ui:CardControl.Style>
                                    <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon CalendarLtr24}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                <Setter Property="Icon" Value="{ui:SymbolIcon Live24}" />
                                            </DataTrigger>
                                            <!-- Legacy: &H91C8C8 row for sessions outside the student's classes -->
                                            <DataTrigger Binding="{Binding IsOutsideMyClasses}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:CardControl.Style>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding TutorName, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding StartText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Actual start time (legacy "وقت البدء الفعلي") -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                                Visibility="{Binding HasLaunched, Converter={StaticResource BoolToVisibility}}">
                                        <ui:SymbolIcon Symbol="Clock16" FontSize="14" Margin="0,0,4,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding LaunchedText, Mode=OneWay}" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                    <Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            ToolTip="{x:Static res:Strings.Session_OutsideMyClassesHint}"
                                            Visibility="{Binding IsOutsideMyClasses, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Static res:Strings.Session_OutsideMyClasses}" FontSize="12"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    </Border>
                                    <Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel, Mode=OneWay}" FontSize="12" />
                                    </Border>
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Video24}"
                                               Content="{x:Static res:Strings.Session_Join}"
                                               Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding Session}" />
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Symbol="CalendarEmpty24" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.Sessions_Empty}" Margin="0,12,0,4" FontSize="16" FontWeight="SemiBold"
                           TextAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.Sessions_EmptyHint}" TextAlignment="Center" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <!-- By program and course + All Programs: the catalog-wide list loads only on Refresh -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding IsAwaitingProgram, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Symbol="Filter24" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.Sessions_ChooseProgram}" Margin="0,12,0,4" FontSize="16" FontWeight="SemiBold"
                           TextAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Static res:Strings.Sessions_ChooseProgramHint}" TextAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                <ui:Button HorizontalAlignment="Center" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Content="{x:Static res:Strings.Sessions_LoadAll}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
