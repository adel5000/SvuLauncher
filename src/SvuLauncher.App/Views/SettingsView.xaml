<UserControl x:Class="SvuLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:SvuLauncher.App.Resources">
    <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Settings_Title}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <!-- Microphone (legacy: clsVolume + chkMicMute) -->
                <TextBlock Text="{x:Static res:Strings.Settings_Microphone}" Style="{StaticResource SectionHeader}" />

                <ui:InfoBar Message="{x:Static res:Strings.Settings_NoMicrophone}" Severity="Warning" IsClosable="False"
                            IsOpen="{Binding HasNoMicrophone, Mode=OneWay}" />

                <StackPanel Visibility="{Binding HasMicrophone, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Mic24" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Settings_MicrophoneOn}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding MicrophoneName}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsMicrophoneOn}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{x:Static res:Strings.Settings_MicrophoneLevel}" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                Value="{Binding MicrophoneLevel}" IsEnabled="{Binding IsMicrophoneOn}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding MicrophoneLevel, StringFormat={}{0:0}}" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>

                <ui:InfoBar Message="{Binding MicrophoneError}" Severity="Error" IsClosable="False" Margin="0,8,0,0"
                            IsOpen="{Binding HasMicrophoneError, Mode=OneWay}" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{x:Static res:Strings.Settings_MuteOnLaunch}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Static res:Strings.Settings_MuteOnLaunchHint}" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MuteMicrophoneOnLaunch}" VerticalAlignment="Center" />
                </Grid>

                <!-- Appearance -->
                <TextBlock Text="{x:Static res:Strings.Settings_Appearance}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{x:Static res:Strings.Settings_Language}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Label" Margin="0,0,0,12" />
                <ui:InfoBar Message="{x:Static res:Strings.Settings_RestartRequired}" Severity="Informational" IsClosable="False"
                            IsOpen="{Binding RestartRequired, Mode=OneWay}" Margin="0,0,0,12" />
                <TextBlock Text="{x:Static res:Strings.Settings_Theme}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label" />
            </StackPanel>
        </ScrollViewer>
    </ui:Card>
</UserControl>
